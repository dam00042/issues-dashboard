{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["UV_*"],
  "globalEnv": [
    "DASHBOARD_API_HOST",
    "DASHBOARD_API_PORT",
    "DASHBOARD_API_RELOAD",
    "DASHBOARD_BOOTSTRAP_PYTHON",
    "HOSTNAME",
    "PORT",
    "NEXT_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
