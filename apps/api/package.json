{
  "name": "@dashboard/api",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "sync": "node scripts/python-runtime.cjs --uv sync --project . --frozen",
    "dev": "node scripts/python-runtime.cjs -m dashboard_api.dev_server",
    "build:exe": "node scripts/build-exe.cjs",
    "lint": "node scripts/python-runtime.cjs -m ruff check . --output-format=full",
    "format": "node scripts/python-runtime.cjs -m ruff format .",
    "format:check": "node scripts/python-runtime.cjs -m ruff format . --check",
    "test": "node scripts/python-runtime.cjs -m pytest"
  }
}
