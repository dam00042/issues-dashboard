# Browser-development defaults. Electron overrides its runtime values itself.
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8010

# Optional: leave empty and configure the token from the app instead.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=20
GITHUB_MAX_PAGES=10

# Paths are relative to apps/api unless absolute paths are supplied.
ISSUES_DATABASE_PATH=data/issues.db
DASHBOARD_PREFERENCES_PATH=data/preferences.json
GITHUB_SESSION_PATH=data/github-session.json
GITHUB_SESSION_KEY_PATH=data/github-session.key

# Electron-only. Do not set these for normal browser development.
DASHBOARD_DESKTOP_MODE=false
DASHBOARD_RUNTIME_SECRET=
