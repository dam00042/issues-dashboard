{
  "name": "@dashboard/desktop",
  "private": true,
  "version": "0.2.0",
  "main": "dist/main.js",
  "scripts": {
    "build:runtime": "tsc --project tsconfig.json",
    "dev": "npm run build:runtime && node scripts/run-electron.cjs . --wait-url=http://127.0.0.1:3000",
    "build": "npm run build:runtime && node scripts/build-desktop.cjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "test": "node --experimental-strip-types --test session-store.test.cjs backend-health.test.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^24.12.0",
    "electron": "41.10.7",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3"
  }
}
